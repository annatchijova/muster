# Copy to .env (already gitignored) before running `npm run dev`/`npm run start`.
# Used only by the two supplementary contract reads in src/handlers/effects.ts
# (poolInfo/assignmentInfo) — log ingestion itself goes through Envio's own
# HyperSync endpoint for Monad testnet, not this RPC URL.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
